  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Entry": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]*$",
            "maxLength": 87382,
            "description": "Unpadded base64url of 0\u201365536 bytes; invalid trailing bits are rejected."
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "description": "Canonical unsigned decimal integer, bounded by u64::MAX at runtime."
          },
          "expires_at_ms": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "description": "UTC Unix milliseconds as decimal text; null means permanent."
          }
        },
        "required": [
          "value",
          "version",
          "expires_at_ms"
        ],
        "additionalProperties": false
      },
      "Condition": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "any"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "absent"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "version"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$",
                "description": "Canonical unsigned decimal integer, bounded by u64::MAX at runtime."
              }
            },
            "required": [
              "kind",
              "version"
            ],
            "additionalProperties": false
          }
        ]
      },
      "DeleteCondition": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "any"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "version"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$",
                "description": "Canonical unsigned decimal integer, bounded by u64::MAX at runtime."
              }
            },
            "required": [
              "kind",
              "version"
            ],
            "additionalProperties": false
          }
        ]
      },
      "GetRequest": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 2,
            "maxLength": 1366,
            "description": "Unpadded base64url encoding of 1\u20131024 arbitrary bytes."
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      },
      "PutRequest": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 2,
            "maxLength": 1366,
            "description": "Unpadded base64url encoding of 1\u20131024 arbitrary bytes."
          },
          "value": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]*$",
            "maxLength": 87382,
            "description": "Unpadded base64url of 0\u201365536 bytes; invalid trailing bits are rejected."
          },
          "ttl_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 18446744073709551615
          },
          "condition": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Condition"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      },
      "DeleteRequest": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 2,
            "maxLength": 1366,
            "description": "Unpadded base64url encoding of 1\u20131024 arbitrary bytes."
          },
          "condition": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DeleteCondition"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      },
      "ScanRequest": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]*$",
            "minLength": 0,
            "maxLength": 1366,
            "description": "Unpadded base64url encoding of 1\u20131024 arbitrary bytes."
          },
          "after_key": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "minLength": 2,
                "maxLength": 1366,
                "description": "Unpadded base64url encoding of 1\u20131024 arbitrary bytes."
              },
              {
                "type": "null"
              }
            ]
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100,
            "default": 100
          }
        },
        "required": [
          "prefix"
        ],
        "additionalProperties": false
      },
      "GetResponse": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "found": {
                "const": false
              }
            },
            "required": [
              "found"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "found": {
                "const": true
              },
              "entry": {
                "$ref": "#/components/schemas/Entry"
              }
            },
            "required": [
              "found",
              "entry"
            ],
            "additionalProperties": false
          }
        ]
      },
      "PutResponse": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "description": "Canonical unsigned decimal integer, bounded by u64::MAX at runtime."
          },
          "expires_at_ms": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "description": "UTC Unix milliseconds as decimal text; null means permanent."
          }
        },
        "required": [
          "version",
          "expires_at_ms"
        ],
        "additionalProperties": false
      },
      "DeleteResponse": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean"
          }
        },
        "required": [
          "deleted"
        ],
        "additionalProperties": false
      },
      "ScanResponse": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "minLength": 2,
                  "maxLength": 1366,
                  "description": "Unpadded base64url encoding of 1\u20131024 arbitrary bytes."
                },
                "entry": {
                  "$ref": "#/components/schemas/Entry"
                }
              },
              "required": [
                "key",
                "entry"
              ],
              "additionalProperties": false
            }
          },
          "next_key": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "minLength": 2,
                "maxLength": 1366,
                "description": "Unpadded base64url encoding of 1\u20131024 arbitrary bytes."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "entries",
          "next_key"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "mutation_outcome_may_be_unknown": {
            "type": "boolean"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Live": {
        "type": "object",
        "properties": {
          "live": {
            "const": true
          }
        },
        "required": [
          "live"
        ],
        "additionalProperties": false
      },
      "Ready": {
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          }
        },
        "required": [
          "ready"
        ],
        "additionalProperties": false
      }
    }
  }
}
