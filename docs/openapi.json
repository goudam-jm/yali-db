{
  "openapi": "3.1.0",
  "info": {
    "title": "YaliDB loopback API",
    "version": "0.1.0",
    "description": "Experimental HTTP/1 API. Every route requires a bearer token. See http-hardening.md for admission limits, framing requirements and deadlines. Parser errors may close without a JSON response. There are no idempotent mutation retries."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7419"
    }
  ],
